classDiagram
    class Учасник обслуговування {
    }

    class Бронювання {
        <<interface>>
        +зробити замовлення()
        +підтвердити замовлення()
        +позначити готовність()
    }

    class Відвідувач {
        -ім'я: String
        +сканувати меню()
        +зробити замовлення()
        +оплатити()
        +оцінити сервіс()
        --
        +Відвідувач(ім'я: String)
    }

    class Офіціант {
        -id: Int
        +підтвердити замовлення()
        +перевірити алергени()
        --
        +Офіціант(id: Int)
        +setСервісЗамовлень(сервіс: Сервіс замовлень)
    }

    class Шеф-кухар {
        -спеціалізація: String
        +позначитиГотовність()
        --
        +Шеф-кухар(спеціалізація: String)
        +setСервісЗамовлень(сервіс: Сервіс замовлень)
    }

    class Замовлення {
        -id: Int
        -статус: String
        +додати позицію()
        +змінити статус()
        --
        +Замовлення()
        +setСервісЗамовлень(сервіс: Сервіс замовлень)
    }

    class Позиція замовлення {
        -страва: String
        -кількість: Int
    }

    class Стіл {
        -номер: Int
        --
        +Стіл(номер: Int)
    }

    class Сервіс оплати {
        +оплатити()
    }

    class Сервіс замовлень {
        +зберегти позицію(item: Позиція замовлення)
        --
        +Сервіс замовлень(з'єднання: Connection)
    }

    Учасник обслуговування <|-- Відвідувач
    Учасник обслуговування <|-- Офіціант
    Учасник обслуговування <|-- Шеф-кухар

    Відвідувач ..|> Бронювання
    Офіціант ..|> Бронювання
    Шеф-кухар ..|> Бронювання

    Замовлення *-- Позиція замовлення
    Стіл o-- Замовлення
    Замовлення ..> Сервіс оплати

    Відвідувач --> Замовлення : створює
    Офіціант --> Замовлення : підтверджує

    %% Впровадження залежностей через setter-метод
    Офіціант --> Сервіс замовлень : <<ін'єкція через setter>>
    Шеф-кухар --> Сервіс замовлень : <<ін'єкція через setter>>
    Замовлення --> Сервіс замовлень : <<ін'єкція через setter>>
    Сервіс замовлень --> Connection : <<ін'єкція через конструктор>>